<!DOCTYPE html>
<html lang="id">
<head>
    <%- include('partials/head') %>
    <title>WhatsApp Groups - WhatsApp Gateway</title>
</head>
<body class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 min-h-screen">
    <div class="flex min-h-screen">
        <%- include('partials/sidebar') %>
        <div class="flex-1 flex flex-col lg:ml-64">
            <%- include('partials/navbar') %>
            <main class="flex-1 p-4 sm:p-6 lg:p-8">
                <div class="max-w-7xl mx-auto">

                    <!-- Page Header -->
                    <div class="mb-8 fade-in">
                        <h1 class="text-3xl font-bold text-gray-800 mb-2">WhatsApp Groups</h1>
                        <p class="text-gray-600">Daftar semua group yang Anda ikuti beserta Group ID untuk pengiriman pesan</p>
                    </div>

                    <!-- Error Alert -->
                    <% if (error) { %>
                        <div class="mb-6 fade-in">
                            <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl p-4 flex items-start">
                                <i class="ri-error-warning-line text-xl mr-3 mt-0.5"></i>
                                <div class="flex-1">
                                    <h4 class="font-semibold mb-1">Error</h4>
                                    <p class="text-sm"><%= error %></p>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Info Card -->
                    <% if (connected && groups.length === 0) { %>
                        <div class="mb-6 fade-in">
                            <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-xl p-4 flex items-start">
                                <i class="ri-information-line text-xl mr-3 mt-0.5"></i>
                                <div class="flex-1">
                                    <h4 class="font-semibold mb-1">Tidak Ada Group</h4>
                                    <p class="text-sm">Anda belum bergabung dengan group WhatsApp apapun.</p>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Groups List -->
                    <% if (connected && groups.length > 0) { %>
                        <!-- Stats Card -->
                        <div class="mb-6 fade-in">
                            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
                                <div class="flex items-center">
                                    <div class="bg-gradient-to-br from-green-400 to-green-600 rounded-xl p-4 mr-4">
                                        <i class="ri-group-line text-white text-3xl"></i>
                                    </div>
                                    <div>
                                        <h3 class="text-2xl font-bold text-gray-800"><%= groups.length %></h3>
                                        <p class="text-gray-600">Total Groups</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Groups Grid -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <% groups.forEach((group, index) => { %>
                                <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 fade-in" style="animation-delay: <%= index * 0.05 %>s">
                                    <!-- Group Header -->
                                    <div class="flex items-start mb-4">
                                        <div class="bg-gradient-to-br from-purple-400 to-purple-600 rounded-xl p-3 mr-4">
                                            <i class="ri-group-2-fill text-white text-2xl"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="text-lg font-semibold text-gray-800 mb-1 truncate"><%= group.name %></h3>
                                            <div class="flex items-center text-sm text-gray-600">
                                                <i class="ri-user-line mr-1"></i>
                                                <span><%= group.participants %> Members</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Group ID -->
                                    <div class="mb-4">
                                        <label class="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2 block">Group ID</label>
                                        <div class="flex items-center bg-gray-50 rounded-lg border border-gray-200 p-3">
                                            <code class="flex-1 text-sm text-gray-800 break-all font-mono" id="groupId-<%= index %>"><%= group.id %></code>
                                            <button
                                                onclick="copyGroupId('<%= group.id %>', <%= index %>)"
                                                class="ml-2 px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg text-xs font-medium transition-colors flex items-center"
                                                id="copyBtn-<%= index %>"
                                            >
                                                <i class="ri-file-copy-line mr-1"></i>
                                                Copy
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Description (if exists) -->
                                    <% if (group.description) { %>
                                        <div class="mb-4">
                                            <label class="text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2 block">Deskripsi</label>
                                            <p class="text-sm text-gray-700 line-clamp-2"><%= group.description %></p>
                                        </div>
                                    <% } %>

                                    <!-- Quick Send Button -->
                                    <div class="mt-4 pt-4 border-t border-gray-100">
                                        <button
                                            onclick="quickSend('<%= group.id %>', '<%= group.name.replace(/'/g, "\\'") %>')"
                                            class="w-full px-4 py-2.5 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white rounded-lg font-medium transition-all duration-300 flex items-center justify-center"
                                        >
                                            <i class="ri-send-plane-fill mr-2"></i>
                                            Kirim Pesan
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        </div>

                        <!-- Usage Example -->
                        <div class="mt-8 fade-in">
                            <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl border border-indigo-100 p-6">
                                <div class="flex items-start mb-4">
                                    <i class="ri-code-box-line text-2xl text-indigo-600 mr-3 mt-1"></i>
                                    <div>
                                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Cara Menggunakan Group ID</h3>
                                        <p class="text-sm text-gray-700 mb-4">Gunakan Group ID untuk mengirim pesan ke group via API:</p>
                                    </div>
                                </div>
                                <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
                                    <pre class="text-sm text-green-400"><code>curl -X POST http://your-server:8181/send-group-message \
  -H "Content-Type: application/json" \
  -H "X-API-KEY: your-api-key" \
  -d '{
    "groupId": "120363123456789012@g.us",
    "message": "Hello group!"
  }'</code></pre>
                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Refresh Button -->
                    <div class="mt-6 fade-in">
                        <button
                            onclick="location.reload()"
                            class="px-6 py-3 bg-white hover:bg-gray-50 text-gray-800 rounded-xl font-medium border border-gray-200 transition-all duration-300 flex items-center mx-auto shadow-lg hover:shadow-xl"
                        >
                            <i class="ri-refresh-line mr-2"></i>
                            Refresh Data
                        </button>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <%- include('partials/bottom-nav') %>
    <%- include('partials/scripts') %>

    <script>
        // Copy Group ID to clipboard
        function copyGroupId(groupId, index) {
            navigator.clipboard.writeText(groupId).then(() => {
                const btn = document.getElementById('copyBtn-' + index);
                const originalHTML = btn.innerHTML;
                btn.innerHTML = '<i class="ri-check-line mr-1"></i>Copied!';
                btn.classList.remove('bg-blue-500', 'hover:bg-blue-600');
                btn.classList.add('bg-green-500');

                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.classList.remove('bg-green-500');
                    btn.classList.add('bg-blue-500', 'hover:bg-blue-600');
                }, 2000);
            }).catch(err => {
                alert('Gagal copy: ' + err);
            });
        }

        // Quick send message to group
        function quickSend(groupId, groupName) {
            const message = prompt('Kirim pesan ke group "' + groupName + '":');
            if (!message) return;

            fetch('/send-group-message', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    groupId: groupId,
                    message: message
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Pesan berhasil dikirim ke group "' + groupName + '"!');
                } else {
                    alert('❌ Gagal mengirim pesan: ' + (data.error || data.details || 'Unknown error'));
                }
            })
            .catch(error => {
                alert('❌ Error: ' + error.message);
            });
        }

        // Add fade-in animation
        document.addEventListener('DOMContentLoaded', () => {
            const fadeElements = document.querySelectorAll('.fade-in');
            fadeElements.forEach((el, index) => {
                setTimeout(() => {
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }, index * 50);
            });
        });
    </script>

    <style>
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</body>
</html>
