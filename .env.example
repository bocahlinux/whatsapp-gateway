PORT=8181
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/whatsapp-webhook
SESSION_SECRET=your-secret-key-change-this

# Cookie security - Set to true only if using HTTPS
# For HTTP (local development or HTTP-only deployments), leave this commented or set to false
# COOKIE_SECURE=false

# Force mention detection for linked devices (workaround for Baileys limitation)
# When enabled, uses phone number matching for mentions
# Useful for WhatsApp Web/Business accounts that use linked device
# FORCE_MENTION_DETECTION=true

# Alternative Bot JIDs for mention detection (comma-separated)
# WhatsApp Business/Linked devices may use different JIDs for mentions
# To find your bot's JID: Tag your bot in a group and check the logs
# Example: BOT_ALTERNATIVE_JIDS=270776867536993@lid,123456789@lid
# BOT_ALTERNATIVE_JIDS=